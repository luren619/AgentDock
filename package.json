{
  "name": "agentdock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "env:encrypt": "node scripts/env-crypt.mjs encrypt",
    "env:decrypt": "node scripts/env-crypt.mjs decrypt",
    "env:check": "node scripts/env-crypt.mjs check",
    "dev": "pnpm --parallel --filter @agentdock/daemon --filter @agentdock/web dev",
    "dev:daemon": "pnpm --filter @agentdock/daemon dev",
    "dev:desktop": "pnpm --filter @agentdock/desktop tauri dev",
    "dev:oauth": "emulate --seed emulate.config.yaml",
    "dev:web": "pnpm --filter @agentdock/web dev",
    "start": "pnpm --parallel --filter @agentdock/daemon --filter @agentdock/web start",
    "build:desktop": "pnpm --filter @agentdock/desktop desktop:build",
    "release:desktop": "pnpm --filter @agentdock/desktop desktop:release",
    "eval:context": "pnpm --filter @agentdock/evals eval:context",
    "eval:context:live": "pnpm --filter @agentdock/evals eval:context:live",
    "dev:docker": "docker compose -f docker-compose.dev.yml up -d",
    "dev:mcp": "npx @modelcontextprotocol/inspector",
    "build": "pnpm --filter @agentdock/daemon build && pnpm --filter @agentdock/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "emulate": "catalog:",
    "typescript": "catalog:"
  }
}
