{
  "name": "@agentdock/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./session-event-store": "./src/storage/session-event-store.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "AGENTDOCK_DATABASE_PATH=../../.agentdock/harness.sqlite tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node --import tsx --env-file-if-exists=../../.env dist/bootstrap.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/static": "catalog:",
    "@huggingface/transformers": "catalog:",
    "@agentdock/agent-runtime": "workspace:*",
    "@agentdock/computer-use": "workspace:*",
    "@agentdock/memory": "workspace:*",
    "@agentdock/policy": "workspace:*",
    "@agentdock/providers": "workspace:*",
    "@agentdock/sandbox": "workspace:*",
    "@agentdock/tools": "workspace:*",
    "es-toolkit": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "tsx": "catalog:",
    "typebox": "catalog:",
    "diff": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
